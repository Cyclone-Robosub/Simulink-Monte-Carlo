


mdl = "Mass_Spring_Damper_System";
open_system(mdl)

%Initial conditions
v0 = 0; %velocity m/s
x0 = 0; %position m
m = 1; %mass kg
b = 1; %Damping Ns/m
k = 1; %stiffness N/m

%Setting runtime
tspan = 20; %duration (s)
dt = 1; %step size (s)
dt_data = 1; 

%simIn = setModelParameter

simIn = Simulink.SimulationInput(mdl);
simout = sim(simIn);
v = simout.v.Data;
x = simout.x.Data;
t = simout.v.Time;
